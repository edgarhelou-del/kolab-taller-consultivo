# Base de datos Postgres (Neon u otra). En Vercel, la integración la agrega sola.
DATABASE_URL=postgres://usuario:clave@servidor/base

# Administrador inicial: con estos datos ingresas la primera vez.
ADMIN_USUARIO=admin
ADMIN_CLAVE=escribe-una-clave-larga

# Recuperación: ponlo en "si" solo si perdiste el acceso de administrador, y quítalo después.
# ADMIN_RESTABLECER=si
